__pycache__/
*.pyc
*.pyo
*.pyd
data/pip.db
data/pip.db-shm
data/pip.db-wal
data/chroma/
data/api_token.txt
data/db_key.txt
# Encrypted database backups (scripts/export_backup.py). Encrypted under a
# user-chosen password is not the same as safe to publish - a .pipbak is a
# complete copy of everything PIP knows, and a password is guessable in a way
# a 256-bit key is not. Anywhere, not just data/, in case one is written to
# the repo root by hand.
*.pipbak
data/salt.bin
data/documents/
data/pip.lock
# Which theme the Flutter client was last set to. Runtime state chosen on
# this machine, same family as api_token.txt - not a project setting.
data/ui_theme.txt
# Startup phases for the launch screen, rewritten on every launch.
data/startup.jsonl
data/backend.log
data/backend.err.log
backend/logs/
# Scratch database from backend/tests/test_schema.py, which names it with a
# RELATIVE path - so it is written wherever pytest was invoked from, which is
# normally the repo root rather than a tmp_path. The glob covers SQLite's
# -journal/-wal/-shm siblings, which is what actually turned up untracked.
test_pip.db*
.venv/
.vs/
.pytest_cache/

# Profiles. Each one is somebody's whole encrypted database, a salt, a vector
# index and their documents - the same four things already ignored at the top
# of data/, just one directory down. profiles.json is the local index of them:
# which profiles exist on THIS machine and which was opened last, which is
# runtime state in the same family as api_token.txt.
data/profiles.json
data/profiles/

# Superseded copies, moved aside rather than deleted by scripts/restore_backup.py
# (previous database, salt, and vector index). Keeping them is deliberate - see
# that script - but they are machine-local and a chroma directory runs to
# megabytes, so they are kept on disk and out of history.
data/*.superseded-*
data/chroma.superseded-*/

# Manifests written by scripts/seed_demo_conversation.py - the ids one run
# wrote, so --undo can remove exactly those. Machine-local, and naming rows in
# a database that is itself not tracked.
data/demo_seed_*.json

# Portable build output (scripts/build_portable.ps1) - over a gigabyte of
# copied interpreter and dependencies, all of it reproducible from .venv.
dist/
